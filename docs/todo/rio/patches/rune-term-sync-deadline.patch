+/// A synchronized update a program never ends gives up at its deadline, but
+/// only an update notices that. No output may come to cause one, so wake for it.
+fn end_stuck_updates(model: &mut Model, tx: &mut Tx) {
+    let now = std::time::Instant::now();
+    for host in model.terminal.iter_mut() {
+        let Some(deadline) = host.surface.sync_update_deadline() else {
+            continue;
+        };
+        if deadline <= now {
+            host.frame_flag.store(true, Ordering::Release);
+        } else {
+            tx.wake_after(deadline - now);
+        }
+    }
+}
