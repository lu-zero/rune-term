+
+#[test]
+fn shrink_keeps_a_mid_line_cursor_on_its_char_and_the_grow_rejoins_it() {
+    let mut grid = Grid::<Square>::new(3, 10, 10);
+    for (i, c) in "abcdefghij".chars().enumerate() {
+        grid[Line(0)][Column(i)] = cell(c);
+    }
+    grid.cursor.pos = Pos::new(Line(0), Column(3));
+
+    grid.resize(true, 3, 4);
+
+    // The blank rows below make room, so the line stays on screen.
+    assert_eq!(grid.history_size(), 0);
+    assert_eq!(grid[Line(0)][Column(3)], wrap_cell('d'));
+    assert_eq!(grid[Line(1)][Column(3)], wrap_cell('h'));
+    assert_eq!(grid[Line(2)][Column(1)], cell('j'));
+    assert_eq!(grid.cursor.pos, Pos::new(Line(0), Column(3)));
+
+    grid.resize(true, 3, 10);
+
+    assert_eq!(grid.history_size(), 0);
+    assert_eq!(grid[Line(0)][Column(9)], cell('j'));
+    assert_eq!(grid.cursor.pos, Pos::new(Line(0), Column(3)));
+    assert!(!grid.cursor.should_wrap);
+}
+
+#[test]
+fn shrink_counts_a_displaced_wide_char_in_the_cursor_column() {
+    let mut grid = Grid::<Square>::new(1, 8, 10);
+    let cells = [
+        cell('a'),
+        cell('b'),
+        cell('c'),
+        wide_cell('中'),
+        spacer_cell(),
+        cell('d'),
+        cell('e'),
+        cell('f'),
+    ];
+    for (i, c) in cells.into_iter().enumerate() {
+        grid[Line(0)][Column(i)] = c;
+    }
+    grid.cursor.pos = Pos::new(Line(0), Column(7));
+
+    grid.resize(true, 1, 4);
+
+    // [abc<leading spacer>] [中<spacer>de] [f...]
+    assert_eq!(grid[Line(-1)][Column(0)], wide_cell('中'));
+    assert_eq!(grid[Line(0)][Column(0)], cell('f'));
+    assert_eq!(grid.cursor.pos, Pos::new(Line(0), Column(0)));
+}
